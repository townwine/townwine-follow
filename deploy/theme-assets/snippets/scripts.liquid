<script>
  {% capture townwine_storefront_home_login_url %}/customer_authentication/login?return_to={{ '/pages/my-page#orders-management' | url_encode }}{% endcapture %}
  window.TownWineCustomer = {
    id: {{ customer.id | default: '' | json }},
    email: {{ customer.email | default: '' | json }},
    firstName: {{ customer.first_name | default: customer.name | default: '' | json }},
    shopDomain: {{ shop.permanent_domain | default: '' | json }}
  };
  window.TownWineRoutes = Object.assign({}, window.TownWineRoutes, {
    storefrontHomeUrl: {{ routes.root_url | json }},
    storefrontHomeLoginUrl: {{ townwine_storefront_home_login_url | strip | json }}
  });
</script>
<script>
  (function () {
    if (window.__townwineFollowHotfix20260615) return;
    window.__townwineFollowHotfix20260615 = true;
    var routes = window.TownWineRoutes || {};
    var storefrontHomeLoginUrl = String(
      routes.storefrontHomeLoginUrl || '/customer_authentication/login?return_to=%2Fpages%2Fmy-page%23orders-management',
    ).trim();
    var originalAlert = window.alert;

    function redirectToStorefrontLogin() {
      if (window.self !== window.top) {
        originalAlert('테마 미리보기에서는 고객 로그인 세션이 전달되지 않아 팔로우 테스트가 제한될 수 있습니다. 실제 스토어프론트 프리뷰 URL에서 고객 로그인 후 다시 확인해 주세요.');
        return;
      }

      originalAlert('로그인해주세요.');
      window.location.href = storefrontHomeLoginUrl;
    }

    function normalizeHandle(value) {
      var handle = String(value || '').trim();

      if (!handle) {
        return '';
      }

      if (/^https?:\/\//i.test(handle)) {
        try {
          var url = new URL(handle, window.location.origin);
          var segments = url.pathname.split('/').filter(Boolean);

          if (segments.length) {
            handle = segments[segments.length - 1];
          }
        } catch (error) {
          console.warn('[follow-hotfix] failed to parse handle URL', error);
        }
      }

      handle = handle
        .split(/[?#]/, 1)[0]
        .replace(/^@+/, '')
        .replace(/\/+$/, '')
        .trim()
        .toLowerCase();

      try {
        handle = decodeURIComponent(handle);
      } catch (error) {
        console.warn('[follow-hotfix] failed to decode handle', error);
      }

      return handle;
    }

    window.influencerAliases = Array.isArray(window.influencerAliases)
      ? window.influencerAliases
      : [];

    document.addEventListener(
      'click',
      function (event) {
        var target = event.target;
        var customer = window.TownWineCustomer || {};

        if (!(target instanceof Element)) {
          return;
        }

        var loginLink = target.closest('a[href*="/account/login"]');

        if (loginLink instanceof HTMLAnchorElement) {
          event.preventDefault();
          event.stopImmediatePropagation();
          window.location.href = storefrontHomeLoginUrl;
          return;
        }

        var button = target.closest('.js-follow-btn');

        if (!(button instanceof HTMLButtonElement)) {
          return;
        }

        var handle = normalizeHandle(button.dataset.influencerHandle || '');
        var customerId = String(button.dataset.customerId || customer.id || '').trim();
        window.influencerAliases = handle ? [handle] : [];

        if (!customerId) {
          event.preventDefault();
          event.stopImmediatePropagation();
          redirectToStorefrontLogin();
        }
      },
      true,
    );

    var originalAlert = window.alert;

    window.alert = function (message) {
      if (message === '팔로우가 취소됐습니다.') {
        return originalAlert('팔로우 취소 되었습니다.');
      }

      return originalAlert(message);
    };

    document.addEventListener('townwine:follow-change', function (event) {
      var detail = event && event.detail;

      if (!detail || detail.phase !== 'confirmed' || detail.following !== true) {
        return;
      }

      originalAlert('팔로우 되었습니다.');
    });
  })();
</script>
