{{ 'townwine.css' | asset_url | stylesheet_tag }}

<style>
  #header-group,
  body > footer {
    display: none !important;
  }

  .ph {
    grid-template-columns: 1fr !important;
  }

  .ph__avwrap,
  .ph__av {
    display: none !important;
  }

  @media (min-width: 880px) {
    .ph {
      grid-template-columns: 1fr !important;
      gap: 36px !important;
    }
  }

  #collector-live,
  #collector-upcoming,
  #collector-library {
    scroll-margin-top: 24px;
  }

  .tw-library-image,
  .tw-live-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phi__pp .pp__d {
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.28;
    font-weight: 600;
    color: var(--c-text);
    letter-spacing: -0.03em;
  }

  .cc {
    display: grid;
    gap: 24px;
  }

  .cc__panel {
    display: grid;
    gap: 0;
  }

  .cc__composer,
  .cc__panel {
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    background: var(--c-bg);
    padding: 24px;
  }

  .cc__count {
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-text-2);
  }

  .cc__count strong {
    color: var(--c-text);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .cc__eyebrow {
    font-size: 12px;
    line-height: 1.5;
    color: var(--c-text-2);
  }

  .cc__label {
    display: block;
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.5;
    font-weight: 600;
    color: var(--c-text);
  }

  .cc__textarea {
    width: 100%;
    min-height: 148px;
    margin-top: 12px;
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    background: transparent;
    padding: 16px 18px;
    font: inherit;
    font-size: 15px;
    line-height: 1.7;
    color: var(--c-text);
    resize: vertical;
  }

  .cc__textarea::placeholder {
    color: var(--c-text-2);
  }

  .cc__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 16px;
  }

  .cc__hint {
    margin: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--c-text-2);
  }

  .cc__status {
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--c-text-2);
  }

  .cc__status[data-tone='error'] {
    color: #8c3b2e;
  }

  .cc__status[data-tone='success'] {
    color: #2f5d44;
  }

  .cc__login {
    display: grid;
    gap: 16px;
  }

  .cc__login-title {
    font-size: 20px;
    line-height: 1.32;
    font-weight: 600;
    color: var(--c-text);
    letter-spacing: -0.03em;
  }

  .cc__login-copy {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--c-text-2);
  }

  .cc__list {
    display: grid;
    gap: 0;
  }

  .cc__empty {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--c-text-2);
  }

  .cc__item {
    padding: 20px 0;
    border-top: 1px solid var(--c-line);
  }

  .cc__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .cc__item:last-child {
    padding-bottom: 0;
  }

  .cc__item-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .cc__item-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .cc__item-name {
    font-size: 15px;
    line-height: 1.5;
    font-weight: 600;
    color: var(--c-text);
  }

  .cc__item-date {
    font-size: 12px;
    line-height: 1.5;
    color: var(--c-text-2);
  }

  .cc__item-actions,
  .cc__edit-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cc__item-actions {
    justify-content: flex-end;
  }

  .cc__action,
  .cc__edit-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    padding: 0 14px;
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    background: transparent;
    font: inherit;
    font-size: 12px;
    line-height: 1;
    font-weight: 500;
    color: var(--c-text);
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .cc__action:hover,
  .cc__edit-button:hover {
    background: rgba(47, 44, 40, 0.04);
  }

  .cc__edit-button--primary {
    border-color: var(--c-dark);
    background: var(--c-dark);
    color: var(--c-ivory);
  }

  .cc__edit-button--primary:hover {
    border-color: var(--c-dark-h);
    background: var(--c-dark-h);
  }

  .cc__item-body {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--c-text);
    white-space: pre-line;
    word-break: keep-all;
  }

  .cc__edit {
    display: grid;
    gap: 12px;
    margin-top: 12px;
  }

  .cc__edit-textarea {
    width: 100%;
    min-height: 120px;
    border: 1px solid var(--c-line);
    border-radius: var(--r-sm);
    background: transparent;
    padding: 14px 16px;
    font: inherit;
    font-size: 15px;
    line-height: 1.7;
    color: var(--c-text);
    resize: vertical;
  }

  @media (max-width: 767px) {
    .cc__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .cc__count {
      margin-top: 12px;
    }

    .cc__item-head,
    .cc__item-actions,
    .cc__edit-actions {
      align-items: stretch;
    }
  }
</style>

{% liquid
  assign collector_handle = metaobject.system.handle | default: ''
  assign collector_url = metaobject.system.url | default: request.path
  assign display_name = metaobject.display_name.value | default: metaobject.customer_name.value | default: collector_handle
  assign collector_profile_definition = metaobjects.collector_profile
  assign current_customer_display_name = ''
  assign current_customer_gid = ''
  assign public_handle = metaobject.public_handle.value | strip
  assign collector_customer_name = metaobject.customer_name.value | strip
  assign role_label = metaobject.role_label.value | strip
  assign bio = metaobject.bio.value | strip
  assign introduction = metaobject.introduction.value | strip
  assign featured_collection_handle = metaobject.featured_collection_handle.value | default: '' | handleize
  assign featured_collection = collections[featured_collection_handle]
  assign specialties_text = metaobject.specialties.value | default: ''
  assign regions_text = metaobject.preferred_regions.value | default: ''
  assign styles_text = metaobject.preferred_styles.value | default: ''
  assign grapes_text = metaobject.preferred_grapes.value | default: ''
  assign price_band = metaobject.price_band.value | default: ''
  assign taste_body = metaobject.taste_body.value | default: 0 | plus: 0
  assign taste_tannin = metaobject.taste_tannin.value | default: 0 | plus: 0
  assign taste_acidity = metaobject.taste_acidity.value | default: 0 | plus: 0
  assign taste_sweetness = metaobject.taste_sweetness.value | default: 0 | plus: 0
  assign taste_alcohol = metaobject.taste_alcohol.value | default: 0 | plus: 0
  assign collector_initial = display_name | strip | slice: 0
  assign collector_match_handles = collector_handle
  assign collector_public_handle_key = public_handle | remove_first: '@' | strip
  if collector_public_handle_key != blank
    assign collector_match_handles = collector_match_handles | append: ',' | append: collector_public_handle_key
  endif
  if display_name != blank
    assign collector_match_handles = collector_match_handles | append: ',' | append: display_name
  endif
  if collector_customer_name != blank
    assign collector_match_handles = collector_match_handles | append: ',' | append: collector_customer_name
  endif
  assign current_timestamp = 'now' | date: '%s' | plus: 0
  assign live_product_count = 0
  assign upcoming_product_count = 0
  assign tracked_product_count = 0
  assign first_live_title = ''
  assign first_upcoming_title = ''
  assign first_upcoming_month = 0
  assign first_upcoming_day = 0
  assign first_upcoming_hour = 0
  assign first_upcoming_minute = 0

  if customer
    assign current_customer_display_name = customer.first_name | default: customer.name
    assign current_customer_gid = 'gid://shopify/Customer/' | append: customer.id

    if collector_profile_definition != blank
      for current_customer_profile in collector_profile_definition.values
        if current_customer_profile.customer_id.value == current_customer_gid
          assign current_customer_profile_display_name = current_customer_profile.display_name.value | strip
          if current_customer_profile_display_name != blank
            assign current_customer_display_name = current_customer_profile_display_name
          endif
          break
        endif
      endfor
    endif
  endif

  if featured_collection != blank
    for product in featured_collection.products
      assign tracked_product_count = tracked_product_count | plus: 1
      capture product_open_at_ts_raw
        render 'townwine-deal-open-timestamp', product: product
      endcapture
      assign product_open_at_ts = product_open_at_ts_raw | strip | plus: 0

      if product_open_at_ts > current_timestamp
        assign upcoming_product_count = upcoming_product_count | plus: 1
        if first_upcoming_title == blank
          assign first_upcoming_title = product.title
          assign first_upcoming_month = product.metafields.custom.deal_open_month | default: product.metafields.custom.deal_open_month.value | default: 0 | plus: 0
          assign first_upcoming_day = product.metafields.custom.deal_open_day | default: product.metafields.custom.deal_open_day.value | default: 0 | plus: 0
          assign first_upcoming_hour = product.metafields.custom.deal_open_hour | default: product.metafields.custom.deal_open_hour.value | default: 0 | plus: 0
          assign first_upcoming_minute = product.metafields.custom.deal_open_minute | default: product.metafields.custom.deal_open_minute.value | default: 0 | plus: 0
        endif
      elsif product.available
        assign live_product_count = live_product_count | plus: 1
        if first_live_title == blank
          assign first_live_title = product.title
        endif
      endif
    endfor
  endif

  assign specialties = specialties_text | split: ','
  assign first_upcoming_day_text = first_upcoming_day | prepend: '0' | slice: -2, 2
  assign first_upcoming_hour_text = first_upcoming_hour | prepend: '0' | slice: -2, 2
  assign first_upcoming_minute_text = first_upcoming_minute | prepend: '0' | slice: -2, 2
  assign has_taste_profile = false
  assign has_specialties = false
  assign has_regions = false
  assign has_styles = false
  assign has_grapes = false
  assign has_price_band = false
  assign has_preference_profile = false
  assign has_profile_section = false
  assign has_philosophy_section = false

  if taste_body > 0 or taste_tannin > 0 or taste_acidity > 0 or taste_sweetness > 0 or taste_alcohol > 0
    assign has_taste_profile = true
  endif

  if regions_text != blank
    assign has_regions = true
  endif

  if styles_text != blank
    assign has_styles = true
  endif

  if grapes_text != blank
    assign has_grapes = true
  endif

  if price_band != blank
    assign has_price_band = true
  endif

  for tag in specialties
    assign tag_label = tag | strip
    if tag_label != blank
      assign has_specialties = true
      break
    endif
  endfor

  if has_regions or has_styles or has_grapes or has_price_band or has_specialties
    assign has_preference_profile = true
  endif

  if has_taste_profile or has_preference_profile
    assign has_profile_section = true
  endif

  if introduction != blank
    assign has_philosophy_section = true
  endif
%}

{% render 'townwine-header', current: 'influencer' %}

<main class="tw-collector-page">
  <div class="container">
    <nav class="bc" aria-label="현재 위치">
      <a href="{{ pages['collectors'].url | default: routes.root_url }}">컬렉터</a>
      <span class="bc__sep">/</span>
      <span class="bc__cur">{{ display_name }}</span>
    </nav>

    <section class="ph" aria-label="컬렉터 대표 영역">
      <div class="ph__avwrap">
        <div class="ph__av" aria-hidden="true">{{ collector_initial }}</div>
      </div>
      <div class="ph__content">
        {% if role_label != blank %}
          <div class="ph__role">{{ role_label }}</div>
        {% endif %}
        <h1 class="ph__name">{{ display_name }}</h1>
        {% if public_handle != blank %}
          <div class="ph__h">{{ public_handle }}</div>
        {% endif %}
        {% if bio != blank %}
          <p class="ph__bio">{{ bio }}</p>
        {% endif %}
        <div
          class="ph__stats"
          data-townwine-collector-summary
          data-influencer-handle="{{ collector_handle | escape }}"
          data-collector-match-handles="{{ collector_match_handles | escape }}"
          data-proxy-base="/apps/townwine-follow"
          data-deals-format="총 공구 {count}회"
          data-loading-followers-label="집계 중"
          data-loading-deals-label="총 공구 집계 중"
        >
          <div>
            <strong data-collector-followers>0 팔로워</strong>
            실시간 팔로워
          </div>
          <div>
            <strong data-collector-deals>총 공구 0회</strong>
            누적 공구
          </div>
          <div>
            <strong data-collector-live-deals>{{ live_product_count }}</strong>
            진행 중 공구
          </div>
          <div>
            <strong data-collector-upcoming-deals>{{ upcoming_product_count }}</strong>
            예정 공구
          </div>
        </div>
        <div class="ph__cta">
          {% render 'townwine-follow-button',
            influencer_handle: collector_handle,
            influencer_name: display_name,
            proxy_base: '/apps/townwine-follow',
            follow_label: '팔로우',
            following_label: '팔로잉',
            button_class: 'btn btn--dark btn--xl ph__follow-btn'
          %}
          {% if upcoming_product_count > 0 %}
            <a class="btn btn--gh btn--xl" href="#collector-upcoming">예정 공구 보기</a>
          {% elsif featured_collection != blank %}
            <a class="btn btn--gh btn--xl" href="#collector-history">공구 내역 보기</a>
          {% endif %}
        </div>
      </div>
    </section>
  </div>

  <style>
  .tw-collector-page{--history-border:#e3dbcf}
  .tw-collector-page .ph{padding:28px 0 32px!important;gap:18px!important}
  .tw-collector-page .ph__name{font-size:32px;line-height:1.3}
  .tw-collector-page .ph__stats{gap:24px;margin:20px 0;font-size:12px}
  .tw-collector-page .ph__cta .btn{min-height:42px;padding:10px 20px;font-size:14px}
  .tw-collector-page .sec{padding-top:36px;padding-bottom:36px}
  .tw-collector-page .sh__t{font-size:24px;line-height:1.4}
  #collector-history{scroll-margin-top:90px}
  #collector-history [hidden]{display:none!important}
  #collector-history .sh{align-items:center;gap:12px;margin-bottom:12px}
  #collector-history [data-history-status]{font-size:13px;color:#827568;margin:0 0 16px}
  .tw-history-order{font-size:12px;color:#827568;white-space:nowrap}

  #collector-history .tw-history-filters{display:grid;grid-template-columns:minmax(180px,1fr) 115px 150px 150px auto;gap:12px;align-items:end;margin:20px 0;background:#fffdf9;border:1px solid #e3dbcf;border-radius:10px;padding:18px}
  #collector-history .tw-history-filters label{display:flex;flex-direction:column;gap:7px;font-size:12px;color:#776957;min-width:0}
  #collector-history .tw-history-filters input,#collector-history .tw-history-filters select{box-sizing:border-box;min-width:0;width:100%;height:42px;padding:0 10px;border:1px solid #d9d0c2;border-radius:6px;background:#fff;color:#342e26;font:inherit;font-size:13px}
  .tw-history-filter-actions{display:flex;gap:6px}
  #collector-history .tw-history-filter-actions button{height:42px;padding:0 14px;border:1px solid #d9d0c2;border-radius:6px;font:inherit;font-size:13px;cursor:pointer;background:#fffdf9;color:#625340;white-space:nowrap}
  #collector-history .tw-history-filter-actions button[type="submit"]{background:#382f25;color:white;border-color:#382f25}
  #collector-history .tw-history-empty{margin:0;padding:34px 20px;text-align:center;color:#7c6e5c;font-size:14px}
  @media(max-width:900px){#collector-history .tw-history-filters{grid-template-columns:1fr 1fr}.tw-history-search{grid-column:1/-1}.tw-history-filter-actions{grid-column:1/-1;justify-content:flex-end}}
  #collector-history .tw-history-tools{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:18px 0 12px}
  #collector-history [data-history-status]{margin:0}
  .tw-history-size{display:flex;align-items:center;gap:8px;font-size:12px;color:#756958;white-space:nowrap}
  #collector-history select{font:inherit;color:#493e30;background:#fffdf9;border:1px solid #d9d0c2;border-radius:6px;min-height:40px;padding:0 26px 0 10px;width:auto}
  .tw-history-table{border:1px solid var(--history-border);border-radius:10px;overflow:hidden;background:#fffdf9}
  #collector-history .tw-history-head,#collector-history .tw-history-row{display:grid;grid-template-columns:minmax(0,1fr) 110px 110px;align-items:center;gap:24px;padding:16px 22px;margin:0;box-sizing:border-box}
  #collector-history .tw-history-head{background:#f1ebe1;color:#776957;font-size:12px;border-bottom:1px solid var(--history-border)}
  #collector-history a.tw-history-row,#collector-history a.tw-history-row:hover,#collector-history a.tw-history-row:visited{text-decoration:none!important;color:#342e26;background-image:none;box-shadow:none;border:0;border-bottom:1px solid var(--history-border);border-radius:0;min-height:104px}
  #collector-history a.tw-history-row:last-child{border-bottom:0}
  #collector-history a.tw-history-row:hover{background-color:#f8f3eb}
  #collector-history .tw-history-row *{text-decoration:none!important}
  #collector-history .tw-history-row:focus-visible{outline:2px solid #987a4f;outline-offset:-3px}
  .tw-history-main{display:flex;align-items:center;gap:18px;min-width:0}
  .tw-history-thumb{display:flex;align-items:center;justify-content:center;width:64px;height:72px;flex:0 0 64px;overflow:hidden;border:1px solid #eee7dc;border-radius:6px;background:#faf7f1}
  .tw-history-thumb img{display:block;width:100%;height:100%;object-fit:contain}
  .tw-history-no-image{font-size:10px;color:#938674}
  .tw-history-title{font-size:14px;font-weight:600;line-height:1.6;overflow-wrap:anywhere}
  .tw-history-country,.tw-history-date{font-size:12px;color:#7c6e5c;white-space:nowrap}
  #collector-history .tw-history-pagination{display:flex;justify-content:center;align-items:center;gap:5px;margin:22px 0 0;flex-wrap:wrap}
  #collector-history .tw-history-page{display:inline-flex;align-items:center;justify-content:center;min-width:40px;height:40px;padding:0 10px;margin:0;border:1px solid #ddd3c4;border-radius:6px;background:#fffdf9;color:#625340;font:inherit;font-size:13px;cursor:pointer}
  #collector-history .tw-history-page[aria-current="page"]{background:#382f25;border-color:#382f25;color:white}
  #collector-history .tw-history-page:disabled{opacity:.4;cursor:default}
  #collector-history .tw-history-page:focus-visible{outline:2px solid #987a4f;outline-offset:2px}
  .tw-history-ellipsis{font-size:12px;color:#8c7b65}
  #collector-library,#collector-live,.tw-collector-page [aria-label="컬렉터 현황"]{display:none}
  @media(max-width:640px){
    .tw-collector-page .ph__name{font-size:27px}.tw-collector-page .ph__stats{gap:16px;flex-wrap:wrap}
    .tw-collector-page .sh__t{font-size:21px}.tw-collector-page .sec{padding-top:26px;padding-bottom:26px}
    #collector-history .tw-history-head{display:none}
    #collector-history .tw-history-row{grid-template-columns:1fr auto;gap:9px 12px;padding:16px;min-height:112px}
    .tw-history-main{grid-column:1/-1;gap:13px;align-items:center}
    .tw-history-thumb{width:52px;height:60px;flex-basis:52px}.tw-history-title{font-size:13px;line-height:1.6}
    .tw-history-country{padding-left:65px}.tw-history-date{text-align:right;font-size:11px}
    #collector-history .tw-history-tools{gap:8px;align-items:center}.tw-history-size>span{display:none}
    #collector-history [data-history-status]{font-size:12px}
    #collector-history .tw-history-page{min-width:34px;height:40px;padding:0 8px;font-size:12px}
    #collector-history .tw-history-pagination{gap:4px}

  }
  </style>
  <section class="sec sec--alt" id="collector-history" aria-label="{{ display_name | escape }}의 공구 내역" data-collector-history data-collector-handle="{{ collector_handle | escape }}" data-currency="{{ shop.currency }}">
    <div class="container">
      <div class="sh"><div><div class="sh__sub">공구 내역</div><h2 class="sh__t">{{ display_name }}의 공구 모아보기</h2></div><span class="tw-history-order">최신순</span></div>
      <form class="tw-history-filters" data-history-filters>
        <label class="tw-history-search">공구명<input name="q" type="search" maxlength="160" placeholder="공구명 또는 와인명" autocomplete="off"></label>
        <label>진행 상태<select name="status"><option value="all">전체</option><option value="active">진행 중</option><option value="ended">종료</option></select></label>
        <label>시작일<input name="from" type="date" aria-label="공구 시작일"></label>
        <label>종료일<input name="to" type="date" aria-label="공구 종료일"></label>
        <div class="tw-history-filter-actions"><button type="submit">검색</button><button type="reset">초기화</button></div>
      </form>
      <div class="tw-history-tools"><p data-history-status role="status">공구 내역을 불러오는 중입니다.</p><label class="tw-history-size"><span>페이지당</span><select data-history-page-size aria-label="페이지당 공구 수"><option value="10">10개씩</option><option value="20">20개씩</option><option value="50">50개씩</option></select></label></div>
      <div class="tw-history-table"><div class="tw-history-head" aria-hidden="true"><span>공구</span><span>국가</span><span>날짜</span></div><div class="tw-history-list" data-history-list></div><p class="tw-history-empty" data-history-empty hidden>조건에 맞는 공구가 없어요. 검색어나 기간을 바꿔보세요.</p></div>
      <nav class="tw-history-pagination" data-history-pagination aria-label="공구 내역 페이지" hidden></nav>
    </div>
  </section>
  <script src="{{ 'townwine-collector-history.js' | asset_url }}" defer></script>

