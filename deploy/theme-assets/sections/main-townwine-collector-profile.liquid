{% render 'townwine-footer' %}
{% render 'townwine-follow-boot' %}
{% render 'townwine-open-alert-boot' %}
<script>
  (function () {
    var ROOT_SELECTOR = '[data-collector-comments]';

    function toArray(value) {
      return Array.prototype.slice.call(value || []);
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function buildSearchParams(root) {
      var params = new URLSearchParams();
      var collectorHandle = String(root.dataset.collectorHandle || '').trim();
      var shopDomain = String(root.dataset.shopDomain || '').trim();
      var customerId = String(root.dataset.customerId || '').trim();

      if (collectorHandle) {
        params.set('collectorHandle', collectorHandle);
      }

      if (shopDomain) {
        params.set('shop', shopDomain);
      }

      if (customerId) {
        params.set('logged_in_customer_id', customerId);
      }

      return params;
    }

    function getFriendlyMessage(message, status) {
      if (message === 'COMMENT_BODY_REQUIRED') {
        return '댓글 내용을 입력해 주세요.';
      }

      if (message === 'COMMENT_BODY_TOO_LONG') {
        return '댓글은 500자 이하로 입력해 주세요.';
      }

      if (message === 'COLLECTOR_HANDLE_REQUIRED') {
        return '컬렉터 정보가 없어 댓글을 불러올 수 없습니다.';
      }

      if (message === 'COMMENT_ID_REQUIRED') {
        return '댓글 정보를 확인할 수 없습니다.';
      }

      if (message === 'COMMENT_NOT_FOUND') {
        return '이미 삭제되었거나 찾을 수 없는 댓글입니다.';
      }

      if (message === 'COMMENT_FORBIDDEN') {
        return '내가 작성한 댓글만 수정하거나 삭제할 수 있습니다.';
      }

      if (message === 'LOGIN_REQUIRED') {
        return '로그인 후 댓글을 남길 수 있습니다.';
      }

      if (status === 404) {
        return '댓글 기능을 준비 중입니다.';
      }

      return '댓글 처리 중 오류가 발생했습니다.';
    }

    function formatCommentDate(value) {
      var date = new Date(value);

      if (Number.isNaN(date.getTime())) {
        return '';
      }

      return date.toLocaleString('ko-KR', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      });
    }

    function sortComments(comments) {
      return toArray(comments).sort(function (left, right) {
        var leftTime = new Date(left && left.createdAt).getTime();
        var rightTime = new Date(right && right.createdAt).getTime();

        if (!Number.isFinite(leftTime) || !Number.isFinite(rightTime)) {
          return 0;
        }

        return rightTime - leftTime;
      });
    }

    function parseJsonResponse(response) {
      return response.text().then(function (rawText) {
        var payload = null;

        try {
          payload = rawText ? JSON.parse(rawText) : null;
        } catch (error) {
          payload = null;
        }

        return {
          response: response,
          payload: payload,
          rawText: rawText,
        };
      });
    }

    function setStatus(root, message, tone) {
      var statusNode = root.querySelector('[data-collector-comments-status]');

      if (!(statusNode instanceof HTMLElement)) {
        return;
      }

      if (!message) {
        statusNode.hidden = true;
        statusNode.textContent = '';
        statusNode.removeAttribute('data-tone');
        return;
      }

      statusNode.hidden = false;
      statusNode.textContent = message;
      statusNode.dataset.tone = tone || 'neutral';
    }

    function setCommentCount(root, count) {
      toArray(document.querySelectorAll('[data-collector-comments-count]')).forEach(function (node) {
        node.textContent = String(count);
      });
    }

    function renderCommentMarkup(comment, editingCommentId) {
      var commentId = String((comment && comment.id) || '').trim();
      var isEditing = commentId && commentId === editingCommentId;
      var itemActions = '';

      if (comment && comment.isOwner && !isEditing) {
        itemActions =
          '<div class="cc__item-actions">' +
          '<button class="cc__action" type="button" data-collector-comment-action="edit" data-comment-id="' +
          escapeHtml(commentId) +
          '">' +
          '편집' +
          '</button>' +
          '<button class="cc__action" type="button" data-collector-comment-action="delete" data-comment-id="' +
          escapeHtml(commentId) +
          '">' +
          '삭제' +
          '</button>' +
          '</div>';
      }

      return (
        '<article class="cc__item" data-comment-id="' +
        escapeHtml(commentId) +
        '">' +
        '<div class="cc__item-head">' +
        '<div class="cc__item-meta">' +
        '<strong class="cc__item-name">' +
        escapeHtml((comment && comment.customerDisplayName) || '와인러버') +
        '</strong>' +
        '<span class="cc__item-date">' +
        escapeHtml(formatCommentDate(comment && comment.createdAt)) +
        ((comment && comment.isEdited) ? ' · 수정됨' : '') +
        '</span>' +
        '</div>' +
        itemActions +
        '</div>' +
        (isEditing
          ? '<form class="cc__edit" data-collector-comment-edit-form data-comment-id="' +
            escapeHtml(commentId) +
            '">' +
            '<textarea class="cc__edit-textarea" name="body" rows="5" maxlength="500" aria-label="댓글 수정" required>' +
            escapeHtml((comment && comment.body) || '') +
            '</textarea>' +
            '<div class="cc__edit-actions">' +
            '<button class="cc__edit-button cc__edit-button--primary" type="submit">저장</button>' +
            '<button class="cc__edit-button" type="button" data-collector-comment-cancel data-comment-id="' +
              escapeHtml(commentId) +
              '">' +
              '취소' +
            '</button>' +
            '</div>' +
            '</form>'
          : '<div class="cc__item-body">' + escapeHtml((comment && comment.body) || '') + '</div>') +
        '</article>'
      );
    }

    function renderComments(root, state) {
      var list = root.querySelector('[data-collector-comments-list]');
      var comments = sortComments(state && state.comments);

      if (!(list instanceof HTMLElement)) {
        return;
      }

      if (!comments.length) {
        setCommentCount(root, 0);
        list.innerHTML = '<p class="cc__empty">첫 댓글을 남겨보세요.</p>';
        return;
      }

      setCommentCount(root, comments.length);
      list.innerHTML = comments
        .map(function (comment) {
          return renderCommentMarkup(comment, state && state.editingCommentId);
        })
        .join('');
    }

    function redirectToLogin(root) {
      var returnTo =
        String(root.dataset.returnTo || '').trim() ||
        (window.location.pathname + window.location.search + window.location.hash);

      var routes = window.TownWineRoutes || {};
        var loginUrl = String(
          routes.storefrontHomeLoginUrl || '/customer_authentication/login?return_to=%2F',
        ).trim();
        window.location.href = loginUrl;
    }

    function buildRequestUrl(root) {
      var proxyBase = String(root.dataset.proxyBase || '/apps/townwine-follow').trim();
      var params = buildSearchParams(root);

      return proxyBase + '/collector-comments?' + params.toString();
    }

    function fetchCommentPayload(root, payload) {
      return fetch(buildRequestUrl(root), {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        credentials: 'same-origin',
        body: JSON.stringify(payload || {}),
      })
        .then(parseJsonResponse)
        .then(function (result) {
          if (result.response.status === 401 || (result.payload && result.payload.message === 'LOGIN_REQUIRED')) {
            redirectToLogin(root);
            return null;
          }

          if (!result.response.ok || !result.payload || result.payload.ok === false) {
            throw {
              message: result.payload && result.payload.message,
              status: result.response.status,
            };
          }

          return result.payload;
        });
    }

    function loadComments(root, state, options) {
      var nextOptions = options || {};

      if (!nextOptions.preserveStatus) {
        setStatus(root, '', '');
      }

      return fetch(buildRequestUrl(root), {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      })
        .then(parseJsonResponse)
        .then(function (result) {
          if (!result.response.ok || !result.payload || result.payload.ok === false) {
            throw {
              message: result.payload && result.payload.message,
              status: result.response.status,
            };
          }

          state.comments = sortComments(result.payload.comments || []);

          if (
            state.editingCommentId &&
            !state.comments.some(function (comment) {
              return String(comment && comment.id) === state.editingCommentId;
            })
          ) {
            state.editingCommentId = '';
          }

          renderComments(root, state);

          if (nextOptions.successMessage) {
            setStatus(root, nextOptions.successMessage, 'success');
          }
        })
        .catch(function (error) {
          var message = getFriendlyMessage(error && error.message, error && error.status);

          if (!nextOptions.keepCommentsOnError) {
            state.comments = [];
            state.editingCommentId = '';
            renderComments(root, state);
          }

          setStatus(root, message, 'error');
          throw error;
        });
    }

    function focusEditTextarea(root, commentId) {
      var editForm = toArray(root.querySelectorAll('[data-collector-comment-edit-form]')).find(function (node) {
        return String(node.getAttribute('data-comment-id') || '') === commentId;
      });

      if (!(editForm instanceof HTMLFormElement)) {
        return;
      }

      var textarea = editForm.querySelector('.cc__edit-textarea');

      if (textarea instanceof HTMLTextAreaElement) {
        textarea.focus();
        textarea.setSelectionRange(textarea.value.length, textarea.value.length);
      }
    }

    function initialize(root) {
      if (!(root instanceof HTMLElement) || root.dataset.collectorCommentsReady === 'true') {
        return;
      }

      root.dataset.collectorCommentsReady = 'true';
      var state = {
        comments: [],
        editingCommentId: '',
      };

      var form = root.querySelector('[data-collector-comments-form]');
      var textarea = root.querySelector('.cc__textarea');
      var submitButton = root.querySelector('[data-collector-comments-submit]');
      var list = root.querySelector('[data-collector-comments-list]');

      loadComments(root, state).catch(function () {});

      if (list instanceof HTMLElement) {
        list.addEventListener('click', function (event) {
          var target = event.target;

          if (!(target instanceof Element)) {
            return;
          }

          var actionButton = target.closest('[data-collector-comment-action]');
          var cancelButton = target.closest('[data-collector-comment-cancel]');

          if (cancelButton instanceof HTMLButtonElement) {
            state.editingCommentId = '';
            renderComments(root, state);
            return;
          }

          if (!(actionButton instanceof HTMLButtonElement)) {
            return;
          }

          var action = String(actionButton.dataset.collectorCommentAction || '').trim();
          var commentId = String(actionButton.dataset.commentId || '').trim();

          if (!commentId) {
            setStatus(root, '댓글 정보를 확인할 수 없습니다.', 'error');
            return;
          }

          if (action === 'edit') {
            state.editingCommentId = commentId;
            renderComments(root, state);
            focusEditTextarea(root, commentId);
            return;
          }

          if (action !== 'delete') {
            return;
          }

          if (!window.confirm('댓글을 삭제할까요?')) {
            return;
          }

          actionButton.disabled = true;
          setStatus(root, '댓글을 삭제하고 있습니다.', 'neutral');

          fetchCommentPayload(root, {
            collectorHandle: root.dataset.collectorHandle || '',
            commentId: commentId,
            intent: 'delete',
          })
            .then(function (payload) {
              if (!payload) {
                return null;
              }

              state.editingCommentId = '';
              return loadComments(root, state, {
                preserveStatus: true,
                keepCommentsOnError: true,
                successMessage: '댓글이 삭제되었습니다.',
              });
            })
            .catch(function (error) {
              setStatus(
                root,
                getFriendlyMessage(error && error.message, error && error.status),
                'error',
              );
            })
            .finally(function () {
              actionButton.disabled = false;
            });
        });

        list.addEventListener('submit', function (event) {
          var target = event.target;

          if (!(target instanceof HTMLFormElement) || !target.matches('[data-collector-comment-edit-form]')) {
            return;
          }

          event.preventDefault();

          var commentId = String(target.dataset.commentId || '').trim();
          var editTextarea = target.querySelector('.cc__edit-textarea');
          var editButtons = toArray(target.querySelectorAll('button'));
          var body = editTextarea instanceof HTMLTextAreaElement ? editTextarea.value.trim() : '';

          if (!commentId) {
            setStatus(root, '댓글 정보를 확인할 수 없습니다.', 'error');
            return;
          }

          if (!(editTextarea instanceof HTMLTextAreaElement) || !body) {
            setStatus(root, '댓글 내용을 입력해 주세요.', 'error');
            if (editTextarea instanceof HTMLTextAreaElement) {
              editTextarea.focus();
            }
            return;
          }

          editButtons.forEach(function (button) {
            if (button instanceof HTMLButtonElement) {
              button.disabled = true;
            }
          });
          setStatus(root, '댓글을 수정하고 있습니다.', 'neutral');

          fetchCommentPayload(root, {
            collectorHandle: root.dataset.collectorHandle || '',
            commentId: commentId,
            intent: 'update',
            body: body,
          })
            .then(function (payload) {
              if (!payload) {
                return null;
              }

              state.editingCommentId = '';
              return loadComments(root, state, {
                preserveStatus: true,
                keepCommentsOnError: true,
                successMessage: '댓글이 수정되었습니다.',
              });
            })
            .catch(function (error) {
              setStatus(
                root,
                getFriendlyMessage(error && error.message, error && error.status),
                'error',
              );
            })
            .finally(function () {
              editButtons.forEach(function (button) {
                if (button instanceof HTMLButtonElement) {
                  button.disabled = false;
                }
              });
            });
        });
      }

      if (!(form instanceof HTMLFormElement) || !(textarea instanceof HTMLTextAreaElement)) {
        return;
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();

        var body = textarea.value.trim();

        if (!body) {
          setStatus(root, '댓글 내용을 입력해 주세요.', 'error');
          textarea.focus();
          return;
        }

        var customerName = String(root.dataset.customerName || '').trim();

        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
        }

        setStatus(root, '댓글을 등록하고 있습니다.', 'neutral');

        fetchCommentPayload(root, {
          collectorHandle: root.dataset.collectorHandle || '',
          body: body,
          customerDisplayName: customerName,
        })
          .then(function (payload) {
            if (!payload) {
              return null;
            }

            textarea.value = '';
            state.editingCommentId = '';
            return loadComments(root, state, {
              preserveStatus: true,
              keepCommentsOnError: true,
              successMessage: '댓글이 등록되었습니다.',
            });
          })
          .catch(function (error) {
            setStatus(
              root,
              getFriendlyMessage(error && error.message, error && error.status),
              'error',
            );
          })
          .finally(function () {
            if (submitButton instanceof HTMLButtonElement) {
              submitButton.disabled = false;
            }
          });
      });
    }

    function boot(root) {
      toArray((root || document).querySelectorAll(ROOT_SELECTOR)).forEach(function (node) {
        initialize(node);
      });
    }

    document.addEventListener('shopify:section:load', function (event) {
      boot(event.target);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        boot(document);
      });
    } else {
      boot(document);
    }
  })();
</script>
<script>
  (function () {
    var NAV_SELECTOR = '[data-collector-section-nav]';

    function toArray(value) {
      return Array.prototype.slice.call(value || []);
    }

    function setActiveLink(links, activeId) {
      var hasMatchingLink = links.some(function (link) {
        var href = link.getAttribute('href') || '';
        return href === '#' + activeId;
      });

      links.forEach(function (link, index) {
        var href = link.getAttribute('href') || '';
        var targetId = href.charAt(0) === '#' ? href.slice(1) : '';
        var isActive = activeId && hasMatchingLink ? targetId === activeId : index === 0;

        link.classList.toggle('is-on', isActive);

        if (isActive) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    }

    function initialize(nav) {
      if (!(nav instanceof HTMLElement) || nav.dataset.collectorSectionNavReady === 'true') {
        return;
      }

      nav.dataset.collectorSectionNavReady = 'true';

      var links = toArray(nav.querySelectorAll('[data-collector-section-link]'));

      if (!links.length) {
        return;
      }

      function syncFromHash() {
        var hash = window.location.hash || '';
        var targetId = hash.charAt(0) === '#' ? hash.slice(1) : '';
        setActiveLink(links, targetId);
      }

      links.forEach(function (link) {
        link.addEventListener('click', function () {
          var href = link.getAttribute('href') || '';
          var targetId = href.charAt(0) === '#' ? href.slice(1) : '';

          setActiveLink(links, targetId);
        });
      });

      window.addEventListener('hashchange', syncFromHash);
      syncFromHash();
    }

    function boot(root) {
      toArray((root || document).querySelectorAll(NAV_SELECTOR)).forEach(function (nav) {
        initialize(nav);
      });
    }

    document.addEventListener('shopify:section:load', function (event) {
      boot(event.target);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        boot(document);
      });
    } else {
      boot(document);
    }
  })();
</script>

