            {% for product in home_deal_products %}
              {% unless product.available %}{% continue %}{% endunless %}
              {% if rendered_natural_count >= 12 %}{% break %}{% endif %}
              {% capture rendered_product_open_at_ts_raw %}{% render 'townwine-deal-open-timestamp', product: product %}{% endcapture %}
              {% assign rendered_product_open_at_ts = rendered_product_open_at_ts_raw | strip | plus: 0 %}
              {% assign is_live_product = false %}
              {% if rendered_product_open_at_ts > 0 %}
                {% if rendered_product_open_at_ts <= current_timestamp %}
                  {% assign is_live_product = true %}
                {% endif %}
              {% else %}
                {% assign is_live_product = true %}
              {% endif %}
              {% if is_live_product and product.tags contains '내추럴' %}
                {% capture rendered_natural_product_token %}|{{ product.id }}|{% endcapture %}
                {% unless rendered_natural_product_tokens contains rendered_natural_product_token %}
                  {% assign rendered_natural_product_tokens = rendered_natural_product_tokens | append: rendered_natural_product_token %}
                  {% render 'townwine-product-card', product: product, proxy_base: section.settings.follow_proxy_base, closed_deal_label: '공구 종료', closed_cta_label: '종료 딜 보기' %}
                  {% assign rendered_natural_count = rendered_natural_count | plus: 1 %}
                {% endunless %}
              {% endif %}
            {% endfor %}
          {% else %}
            <article class="dc dc--preview deal-empty">
              <div class="dc__bd">
                <div>
                  <h3 class="dc__t">{{ filtered_deals_empty_title }}</h3>
                </div>
              </div>
            </article>
          {% endif %}
        </div>

        <div
          class="deal-grid"
          data-home-results-panel="바로배송"
          data-result-count="{{ ready_count }}"
          data-results-url="{{ deal_results_ready_url }}"
          hidden
          aria-hidden="true"
        >
          {% if ready_count > 0 %}
            {% assign rendered_ready_count = 0 %}
            {% assign rendered_ready_product_tokens = '|' %}
            {% for product in home_upcoming_products %}
              {% unless product.available %}{% continue %}{% endunless %}
              {% if rendered_ready_count >= 12 %}{% break %}{% endif %}
              {% capture rendered_product_open_at_ts_raw %}{% render 'townwine-deal-open-timestamp', product: product %}{% endcapture %}
              {% assign rendered_product_open_at_ts = rendered_product_open_at_ts_raw | strip | plus: 0 %}
              {% if rendered_product_open_at_ts > 0 and rendered_product_open_at_ts <= current_timestamp and product.tags contains '바로배송' %}
                {% capture rendered_ready_product_token %}|{{ product.id }}|{% endcapture %}
                {% unless rendered_ready_product_tokens contains rendered_ready_product_token %}
                  {% assign rendered_ready_product_tokens = rendered_ready_product_tokens | append: rendered_ready_product_token %}
                  {% render 'townwine-product-card', product: product, proxy_base: section.settings.follow_proxy_base, closed_deal_label: '공구 종료', closed_cta_label: '종료 딜 보기' %}
                  {% assign rendered_ready_count = rendered_ready_count | plus: 1 %}
                {% endunless %}
              {% endif %}
            {% endfor %}
            {% for product in home_deal_products %}
              {% unless product.available %}{% continue %}{% endunless %}
              {% if rendered_ready_count >= 12 %}{% break %}{% endif %}
              {% capture rendered_product_open_at_ts_raw %}{% render 'townwine-deal-open-timestamp', product: product %}{% endcapture %}
              {% assign rendered_product_open_at_ts = rendered_product_open_at_ts_raw | strip | plus: 0 %}
              {% assign is_live_product = false %}
              {% if rendered_product_open_at_ts > 0 %}
                {% if rendered_product_open_at_ts <= current_timestamp %}
                  {% assign is_live_product = true %}
                {% endif %}
              {% else %}
                {% assign is_live_product = true %}
              {% endif %}
              {% if is_live_product and product.tags contains '바로배송' %}
                {% capture rendered_ready_product_token %}|{{ product.id }}|{% endcapture %}
                {% unless rendered_ready_product_tokens contains rendered_ready_product_token %}
                  {% assign rendered_ready_product_tokens = rendered_ready_product_tokens | append: rendered_ready_product_token %}
                  {% render 'townwine-product-card', product: product, proxy_base: section.settings.follow_proxy_base, closed_deal_label: '공구 종료', closed_cta_label: '종료 딜 보기' %}
                  {% assign rendered_ready_count = rendered_ready_count | plus: 1 %}
                {% endunless %}
              {% endif %}
            {% endfor %}
          {% else %}
            <article class="dc dc--preview deal-empty">
              <div class="dc__bd">
                <div>
                  <h3 class="dc__t">{{ filtered_deals_empty_title }}</h3>
                </div>
              </div>
            </article>
          {% endif %}
        </div>

        {% if paginate.pages > 1 %}
          <noscript>{{ paginate | default_pagination }}</noscript>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <div class="deal-grid" data-home-results-panel="" data-result-count="0" data-results-url="{{ deal_results_base_url }}">
        <article class="dc dc--preview">
          <div class="dc__m">
            <div class="dc__preview-bd">
              <div class="l">{{ deals_setup_badge_label }}</div>
              <div class="v">{{ deals_setup_value_label }}</div>
              <div class="t">{{ deals_setup_title }}</div>
            </div>
          </div>
          <div class="dc__bd">
            <div>
              <h3 class="dc__t">{{ deals_setup_body }}</h3>
              <p style="font-size:12px;color:var(--c-text-2);line-height:1.6;margin-top:6px">{{ deals_setup_caption }}</p>
            </div>
          </div>
        </article>
      </div>
    {% endif %}

    {% assign upcoming_deal_count = 0 %}
    {% for product in home_upcoming_display_products %}
      {% capture product_open_at_ts_raw %}{% render 'townwine-deal-open-timestamp', product: product %}{% endcapture %}
      {% assign product_open_at_ts = product_open_at_ts_raw | strip | plus: 0 %}
      {% if product_open_at_ts > current_timestamp and product_open_at_ts <= upcoming_window_end_timestamp %}
        {% assign upcoming_deal_count = upcoming_deal_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    <div
      data-townwine-open-alert-section
      data-proxy-base="{{ section.settings.follow_proxy_base | default: '/apps/townwine-follow' }}"
      data-upcoming-price-prefix="{{ section.settings.upcoming_price_prefix | default: '예상' | escape }}"
      data-upcoming-limited-stock-suffix="{{ section.settings.upcoming_limited_stock_suffix | default: '병 한정' | escape }}"
      data-upcoming-open-suffix="{{ section.settings.upcoming_open_suffix | default: '오픈' | escape }}"
      data-upcoming-alert-label="{{ section.settings.upcoming_alert_label | default: '오픈 알림' | escape }}"
      data-upcoming-alerted-label="{{ section.settings.upcoming_alerted_label | default: '알림 ✓' | escape }}"
    >
      <div class="sh" style="margin-top:48px">
        <div>
          <div class="sh__sub">{{ section.settings.upcoming_eyebrow | default: '예정 공구' }}</div>
          <h2 class="sh__t">{{ section.settings.upcoming_heading | default: '앞으로 4주 동안 열릴 와인' }}</h2>
        </div>
      </div>

      <div class="up">
        {% if upcoming_deal_count > 0 %}
          {% assign rendered_upcoming_count = 0 %}
          {% for product in home_upcoming_display_products %}
            {% capture product_open_at_ts_raw %}{% render 'townwine-deal-open-timestamp', product: product %}{% endcapture %}
            {% assign product_open_at_ts = product_open_at_ts_raw | strip | plus: 0 %}
            {% if product_open_at_ts > current_timestamp and product_open_at_ts <= upcoming_window_end_timestamp and rendered_upcoming_count < upcoming_limit %}
              {% render 'townwine-upcoming-product-row', product: product, proxy_base: section.settings.follow_proxy_base %}
              {% assign rendered_upcoming_count = rendered_upcoming_count | plus: 1 %}
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="up__r" aria-hidden="true" style="cursor:default">
            <div class="up__bd">
              <div class="up__bd__t">{{ upcoming_empty_label }}</div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<section class="sec" id="quote-calculator" aria-label="와인 견적 계산기" data-nosnippet>
  <div class="container">
    <div class="quote-strip">
