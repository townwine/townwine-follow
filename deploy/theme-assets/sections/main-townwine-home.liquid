<section class="sec" id="style-guide" aria-label="스타일 탐색">
  <div class="container">
    <div class="sh">
      <div>
        <div class="sh__sub">{{ style_eyebrow }}</div>
        <h2 class="sh__t">{{ style_heading }}</h2>
      </div>
    </div>
    <div class="cat-grid">
      {% assign rendered_style_card_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'style_card' %}
          {% assign rendered_style_card_count = rendered_style_card_count | plus: 1 %}
          {% liquid
            assign style_card_link = block.settings.link
            assign style_card_tag = block.settings.filter_tag | strip
            assign style_card_number = rendered_style_card_count
            assign portable_style_card_asset = ''
            if rendered_style_card_count < 10
              assign style_card_number = '0' | append: rendered_style_card_count
            endif
            case rendered_style_card_count
              when 1
                assign portable_style_card_asset = 'townwine-live-style-01.png'
              when 2
                assign portable_style_card_asset = 'townwine-live-style-02.png'
              when 3
                assign portable_style_card_asset = 'townwine-live-style-03.png'
              when 4
                assign portable_style_card_asset = 'townwine-live-style-04.png'
            endcase
            if style_card_tag != blank
              capture style_card_link
                echo deal_results_base_url
                echo '?tag='
                echo style_card_tag | url_encode
              endcapture
            endif
            if style_card_link == blank
              assign style_card_link = deal_results_base_url
            endif
          %}
          <a class="ct" href="{{ style_card_link }}" {{ block.shopify_attributes }}>
            <div class="ct__num">{{ style_card_number }}</div>
            <div class="ct__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'ct__image', widths: '360, 560, 760, 960, 1200', sizes: '(min-width: 700px) 25vw, 50vw', loading: 'lazy', alt: block.settings.title | default: block.settings.image.alt | default: shop.name }}
              {% elsif portable_style_card_asset != blank %}
                <img
                  src="{{ portable_style_card_asset | asset_url }}"
                  class="ct__image"
                  alt="{{ block.settings.title | default: shop.name | escape }}"
                  loading="lazy"
                >
              {% endif %}
            </div>
            <div class="ct__content">
              <div class="ct__nm">{{ block.settings.title }}</div>
              {% if block.settings.description != blank %}
                <div class="ct__d">{{ block.settings.description }}</div>
              {% endif %}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="sec sec--alt" aria-label="서비스 안내">
