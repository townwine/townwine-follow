                            data-collector-match-handles="{{ live_collector_match_handles | escape }}"
                            data-proxy-base="{{ section.settings.follow_proxy_base }}"
                            data-loading-followers-label="{{ collector_loading_followers_label | escape }}"
                            data-loading-deals-label="{{ collector_loading_deals_label | escape }}"
