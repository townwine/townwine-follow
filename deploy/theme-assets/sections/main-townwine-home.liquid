    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--c-line);
    border-radius: 24px;
    background:
      linear-gradient(
        90deg,
        rgba(247, 242, 231, 0.96) 0%,
        rgba(255, 255, 255, 0.98) 48%,
        rgba(247, 242, 231, 0.96) 100%
