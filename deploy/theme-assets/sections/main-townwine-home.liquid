{% liquid
  assign hero_script_slide_count = 0
  assign should_load_hero_slider = false
  for block in section.blocks
    if block.type == 'hero_slide' and block.settings.image != blank
      assign hero_script_slide_count = hero_script_slide_count | plus: 1
      if hero_script_slide_count > 1
        assign should_load_hero_slider = true
        break
      endif
    endif
  endfor
%}

