{% liquid
  assign deal_collection = section.settings.deals_collection
  assign upcoming_collection = section.settings.upcoming_collection
  assign deal_source_collection = blank
  assign upcoming_source_collection = blank
  assign hero_slide_count = 0
  assign portable_hero_asset = 'townwine-live-home-hero.jpg'

  for block in section.blocks
    if block.type == 'hero_slide' and block.settings.image != blank
      assign hero_slide_count = hero_slide_count | plus: 1
    endif
  endfor

  if deal_collection == blank or deal_collection.products_count == 0
    assign deal_collection = upcoming_collection
  endif

  if deal_collection == blank or deal_collection.products_count == 0
    assign deal_collection = collections['all']
  endif

  assign deal_source_collection = collections['all']

  assign deal_results_base_url = pages['deals-latest-20260529'].url | default: '/pages/deals-latest-20260529'
  capture deal_results_red_url
    echo deal_results_base_url
    echo '?tag='
    echo '레드' | url_encode
  endcapture
  capture deal_results_white_url
    echo deal_results_base_url
    echo '?tag='
    echo '화이트' | url_encode
  endcapture
  capture deal_results_sparkling_url
    echo deal_results_base_url
    echo '?tag='
    echo '스파클링' | url_encode
  endcapture
  capture deal_results_natural_url
    echo deal_results_base_url
    echo '?tag='
    echo '내추럴' | url_encode
  endcapture
  capture deal_results_ready_url
    echo deal_results_base_url
    echo '?tag='
    echo '바로배송' | url_encode
  endcapture
  if upcoming_collection == blank or upcoming_collection.products_count == 0
    assign upcoming_collection = deal_collection
  endif
  if upcoming_collection == blank or upcoming_collection.products_count == 0
    assign upcoming_collection = collections['all']
  endif
  assign upcoming_source_collection = upcoming_collection
  assign style_link_collection = section.settings.style_link_collection
  if style_link_collection == blank
    assign style_link_collection = deal_collection
  endif
  assign current_timestamp = 'now' | date: '%s' | plus: 0
  assign upcoming_window_seconds = 2419200
  assign upcoming_window_end_timestamp = current_timestamp | plus: upcoming_window_seconds
  assign upcoming_limit = section.settings.upcoming_limit | default: 4 | plus: 0
  if upcoming_source_collection != blank and upcoming_source_collection.products_count > 0
    assign home_upcoming_products = upcoming_source_collection.products | where: 'published_at' | sort: 'published_at' | reverse
    assign home_upcoming_products = home_upcoming_products | sort: 'created_at' | reverse
  endif
  assign home_upcoming_display_products = home_upcoming_products
  assign upcoming_display_has_future_product = false
  if home_upcoming_display_products != blank and home_upcoming_display_products.size > 0
    for product in home_upcoming_display_products
      capture upcoming_display_product_open_at_ts_raw
        render 'townwine-deal-open-timestamp', product: product
      endcapture
      assign upcoming_display_product_open_at_ts = upcoming_display_product_open_at_ts_raw | strip | plus: 0
      if upcoming_display_product_open_at_ts > current_timestamp and upcoming_display_product_open_at_ts <= upcoming_window_end_timestamp
        assign upcoming_display_has_future_product = true
        break
      endif
    endfor
  endif
  if upcoming_display_has_future_product == false and collections['all'] != blank and collections['all'].products_count > 0
    assign home_upcoming_display_products = collections['all'].products | where: 'published_at' | sort: 'published_at' | reverse
    assign home_upcoming_display_products = home_upcoming_display_products | sort: 'created_at' | reverse
  endif
  if deal_source_collection != blank and deal_source_collection.products_count > 0
    assign home_deal_products = deal_source_collection.products | where: 'published_at' | sort: 'published_at' | reverse
    assign home_deal_products = home_deal_products | sort: 'created_at' | reverse
  endif
%}

