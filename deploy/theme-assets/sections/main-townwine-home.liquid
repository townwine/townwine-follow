                  {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'hero__slide-image', widths: '768, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: block.settings.image.alt | default: shop.name }}
                {% else %}
