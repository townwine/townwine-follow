<script>
  (function () {
    function removeUpcomingAlertButtons(root) {
      Array.prototype.slice
        .call((root || document).querySelectorAll('[data-townwine-open-alert-section] .up__a'))
        .forEach(function (node) {
          node.remove();
        });
    }

    function bootUpcomingAlertButtonCleanup() {
      var section = document.querySelector('[data-townwine-open-alert-section]');

      removeUpcomingAlertButtons(document);

      if (!(section instanceof HTMLElement) || section.dataset.alertButtonCleanup === 'true') {
        return;
      }

      section.dataset.alertButtonCleanup = 'true';
      new MutationObserver(function () {
        removeUpcomingAlertButtons(section);
      }).observe(section, {
        childList: true,
        subtree: true,
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootUpcomingAlertButtonCleanup, { once: true });
    } else {
      bootUpcomingAlertButtonCleanup();
    }
  })();
</script>

